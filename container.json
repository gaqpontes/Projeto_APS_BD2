{
  "name": "Rede Dor — Java, React e PostgreSQL",
  "dockerComposeFile": [
    "compose.yml",
    ".devcontainer/compose.dev.yml"
  ],
  "service": "app",
  "runServices": [
    "db",
    "app",
    "frontend-dev"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack"
      ]
    }
  }
}
